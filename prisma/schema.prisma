// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          Int           @id @default(autoincrement())
  name        String        @unique
  email       String        @unique
  password    String
  UserTitle UserTitle[]
  UserMedal   UserMedal[]
  created_at DateTime
  updated_at DateTime 
}

model UserTitle {
  user_id   Int
  title     String
  created_at DateTime  @default(now())
  updated_at DateTime
  deleted_at DateTime?
  User      User      @relation(fields: [user_id], references: [user_id])
  Title     Title     @relation(fields: [title], references: [title])
  IsChosen  Boolean
  Valid     Boolean

  @@id([user_id, title])
}

model Title {
  title       String        @id
  description String?
  UserTitle UserTitle[]
  created_at DateTime
  updated_at DateTime
}

model Medal {
  name      String      @id
  condition String
  created_at DateTime
  updated_at DateTime
  UserMedal UserMedal[]
}

model MedalInstance {
  medal_id   Int       @id @default(autoincrement())
  user_id    Int
  medal_name String
  UserMedal  UserMedal @relation(fields: [user_id, medal_name], references: [user_id, medal_name], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
}

model UserMedal {
  user_id       Int
  medal_name    String
  total_level   Int @default(0)
  User          User            @relation(fields: [user_id], references: [user_id])
  Medal         Medal           @relation(fields: [medal_name], references: [name], onDelete: Cascade)
  MedalInstance MedalInstance[]

  @@id([user_id, medal_name])
}

model Event {
  event_id Int @id @default(autoincrement())
  event_name String?
  host_id Int?
  planned_interval_id Int? @unique
  PlannedInterval      Interval?      @relation(name: "PlannedIntervalRelation", fields: [planned_interval_id], references: [interval_id])
  real_interval_id Int? @unique
  RealInterval      Interval?      @relation(name: "RealIntervalRelation", fields: [real_interval_id], references: [interval_id])
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Interval {
  interval_id Int @id @default(autoincrement())
  begin_time DateTime
  end_time DateTime
  EventsPlanned      Event?    @relation(name: "PlannedIntervalRelation")
  EventsReal          Event?    @relation(name: "RealIntervalRelation") 
  //Botar algo para deletar caso não esteja fazendo nenhuma relação
}

enum Elos {
  Bronze
  Prata
  Ouro
  Diamante
  Sexo
}
